<services>
  <!-- Pull the bundle straight from the public GitHub repo. Runs server-side
       and is re-executed periodically, so new release tags are picked up and
       rebuilt automatically. The debian/* packaging is sourced from
       packaging/debian/ in the same checkout (no duplication here). -->
  <service name="tar_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/ciroiriarte/pve-tools.git</param>
    <param name="filename">pve-tools</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="match-tag">v*</param>
    <param name="extract-rename">packaging/debian/control:debian.control</param>
    <param name="extract-rename">packaging/debian/rules:debian.rules</param>
    <param name="extract-rename">packaging/debian/changelog:debian.changelog</param>
    <param name="extract-rename">packaging/debian/copyright:debian.copyright</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <!-- Sync the version detected from the git tag into the .dsc and the
       debian changelog, so a new release tag bumps the package version with
       no OBS-side edits. -->
  <service name="set_version">
    <param name="basename">pve-tools</param>
    <param name="file">pve-tools.dsc</param>
  </service>
</services>
